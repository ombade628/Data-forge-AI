# ---------------------------------------------------------------------------
# Infrastructure
# ---------------------------------------------------------------------------
# Local Docker (docker compose up):
DATABASE_URL=postgresql+asyncpg://dataforge:dataforge@postgres:5432/dataforge
# Local without Docker (uvicorn app.main:app directly):
# DATABASE_URL=sqlite+aiosqlite:///./dataforge.db
# Free production DB (Neon — does not expire):
#   1. Create a free project at https://neon.tech (region: Singapore)
#   2. Copy the connection string — it looks like:
#      postgresql://user:pass@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
#   3. Paste it verbatim (do NOT change the scheme). Both alembic/env.py and
#      app/db/session.py rewrite it to the correct driver for their needs.

# Redis is only required when JOB_EXECUTION=celery.
REDIS_URL=redis://redis:6379/0
# "inline" runs generation synchronously inside the API request.
# "celery" hands it to a background worker (needs Redis + a worker process).
JOB_EXECUTION=inline

# ---------------------------------------------------------------------------
# Auth — always override JWT_SECRET_KEY before deploying
# ---------------------------------------------------------------------------
JWT_SECRET_KEY=replace-with-a-long-random-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# ---------------------------------------------------------------------------
# AI provider
# ---------------------------------------------------------------------------
# "local" runs deterministically with no API key and no cost. This is the
# default and is what the free Render deployment uses.
LLM_PROVIDER=local
LLM_MODEL=local-template-generator
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# CORS — comma-separated list of allowed frontend origins
# ---------------------------------------------------------------------------
# Local dev:
CORS_ORIGINS=http://localhost:3000
# Vercel frontend + Render frontend (comma-separated, no trailing slash):
# CORS_ORIGINS=https://dataforge-web.vercel.app,https://dataforge-web.onrender.com

# ---------------------------------------------------------------------------
# Object storage — optional, not used by the MVP
# ---------------------------------------------------------------------------
S3_ENDPOINT_URL=
S3_BUCKET=dataforge
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=